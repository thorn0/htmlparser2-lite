{
  "name": "htmlparser2-lite",
  "description": "Fast & forgiving HTML/XML parser for the browser, < 9 KB minified, no dependencies, htmlparser2-compatible",
  "version": "2.0.2",
  "contributors": [
    "Felix Boehm <me@feedic.com>",
    "Georgii Dolzhykov <georgii.dolzhykov@gmail.com>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thorn0/htmlparser2-lite.git"
  },
  "keywords": [
    "html",
    "htmlparser",
    "htmlparser2",
    "markup",
    "xml",
    "dom"
  ],
  "main": "./htmlparser2-lite.js",
  "types": "./htmlparser2-lite.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./htmlparser2-lite.d.mts",
        "default": "./htmlparser2-lite.mjs"
      },
      "require": {
        "types": "./htmlparser2-lite.d.ts",
        "default": "./htmlparser2-lite.js"
      }
    },
    "./package.json": "./package.json"
  }
}
